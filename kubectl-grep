#!/usr/bin/env bash
set -uo pipefail

RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/kubectl-grep"
CACHE_FILE="$CACHE_DIR/api-resources"
CACHE_TTL=86400

# --not-ready: drop rows that look healthy. Matches Completed/Succeeded phases
# and any X/X ratio (e.g. 1/1, 3/3) in the READY column.
NOT_READY_REGEX='Completed|Succeeded|([0-9]+)/\1'

usage_short() {
    echo "Usage: kubectl grep <api-resource> <query>   (query matches any column, like |grep)" >&2
    echo "       kubectl grep --help    for full help" >&2
}

usage() {
    cat <<'EOF'
Usage: kubectl grep <resource>[/<query>] [query] [flags]

Shortcut for `kubectl get <resource> | grep <query>`. The query matches
anywhere on the row (NAME, STATUS, AGE, ...), just like piping to grep.
Glob (*, ?) is supported on both the resource arg and the query. If the
resource arg matches multiple api-resources, the plugin runs across all
of them.

Forms:
  kubectl grep pod nginx              pods whose row contains 'nginx'
  kubectl grep pod 7d                 pods whose row contains '7d' (e.g. AGE)
  kubectl grep pod Running            pods in Running state
  kubectl grep pod/nginx              same as `pod nginx`, slash notation
  kubectl grep 'pod*' nginx           multi-resource: pods, podtemplates, ...
  kubectl grep '*/nginx'              all resources, row contains 'nginx'
  kubectl grep 'pod*' 'nginx*'        glob on both args

Flags:
  -A, --all-namespaces                default
  -n, --namespace <ns>                scope to one namespace
  -i, --ignore-case                   pass -i to grep
  -v, --invert-match                  pass -v to grep
  -E, --regex                         treat query as raw regex (no glob translation)
  -c, --compact                       compact output: <ns>\t<r>/<name> per line
  -nr, --not-ready                    drop healthy rows: Completed|Succeeded|X/X
      --refresh-cache                 force api-resources refetch
  -h, --help                          this message
  Any other flag                      pass-through to kubectl

Cache: ~/.cache/kubectl-grep/api-resources (TTL 24h)

Multi-resource output:
  Default: one labeled section per resource type, full kubectl columns preserved.
  Compact (-c): <namespace>\t<resource>/<name> per line, awk/xargs-friendly:
    kubectl grep -c '*/nginx' | awk '{print "-n " $1 " " $2}' | xargs -L1 kubectl get
EOF
}

# ── argument parsing ───────────────────────────────────────────────────────────
ALL_NS=true
NAMESPACE=""
GREP_FLAGS=()
EXTRA_KUBECTL_ARGS=()
REFRESH=false
COMPACT=false
NOT_READY=false
REGEX_QUERY=false
RESOURCE=""
PATTERN=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -A|--all-namespaces) ALL_NS=true; NAMESPACE=""; shift ;;
        -n) [[ $# -ge 2 ]] || { echo -e "${RED}Error: -n requires an argument${NC}" >&2; exit 2; }
            NAMESPACE="$2"; ALL_NS=false; shift 2 ;;
        # -nr must precede -n* glob, otherwise it would parse as namespace="r".
        -nr|--not-ready) NOT_READY=true; shift ;;
        -n*) NAMESPACE="${1#-n}"; ALL_NS=false; shift ;;
        --namespace) [[ $# -ge 2 ]] || { echo -e "${RED}Error: --namespace requires an argument${NC}" >&2; exit 2; }
            NAMESPACE="$2"; ALL_NS=false; shift 2 ;;
        --namespace=*) NAMESPACE="${1#--namespace=}"; ALL_NS=false; shift ;;
        -i|--ignore-case) GREP_FLAGS+=("-i"); shift ;;
        -v|--invert-match) GREP_FLAGS+=("-v"); shift ;;
        -E|--regex) REGEX_QUERY=true; shift ;;
        -c|--compact) COMPACT=true; shift ;;
        --refresh-cache) REFRESH=true; shift ;;
        # Common kubectl value-taking flags: support split form (-o wide).
        -o|--output|-l|--selector)
            [[ $# -ge 2 ]] || { echo -e "${RED}Error: $1 requires an argument${NC}" >&2; exit 2; }
            EXTRA_KUBECTL_ARGS+=("$1" "$2"); shift 2 ;;
        --) shift
            while [[ $# -gt 0 ]]; do
                if [[ -z "$RESOURCE" ]]; then RESOURCE="$1"
                elif [[ -z "$PATTERN" ]]; then PATTERN="$1"
                else echo -e "${RED}Unexpected argument: $1${NC}" >&2; exit 2
                fi
                shift
            done
            break ;;
        # Unknown flag: forward to `kubectl get`. Joined (-owide) and = forms
        # (--output=wide, --field-selector=...) work as a single token.
        -*) EXTRA_KUBECTL_ARGS+=("$1"); shift ;;
        *)
            if [[ -z "$RESOURCE" ]]; then RESOURCE="$1"
            elif [[ -z "$PATTERN" ]]; then PATTERN="$1"
            else echo -e "${RED}Unexpected argument: $1${NC}" >&2; exit 2
            fi
            shift ;;
    esac
done

# Slash notation: split single positional on first /
if [[ -z "$PATTERN" && "$RESOURCE" == */* ]]; then
    PATTERN="${RESOURCE#*/}"
    RESOURCE="${RESOURCE%%/*}"
fi
# Resource validation deferred to main(): standalone --refresh-cache may run
# without a resource arg, and refresh_cache is not yet defined here.

# ── glob → regex ───────────────────────────────────────────────────────────────
glob_to_regex() {
    local s="$1"
    s=${s//\\/\\\\}
    s=${s//./\\.}
    s=${s//+/\\+}
    s=${s//\{/\\\{}
    s=${s//\}/\\\}}
    s=${s//\^/\\^}
    s=${s//\$/\\\$}
    s=${s//\*/.*}
    s=${s//\?/.}
    printf '%s' "$s"
}

# ── cache ──────────────────────────────────────────────────────────────────────
needs_refresh() {
    [[ "$REFRESH" == true ]] && return 0
    [[ ! -s "$CACHE_FILE" ]] && return 0
    local mtime now
    mtime=$(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0)
    now=$(date +%s)
    (( now - mtime > CACHE_TTL ))
}

refresh_cache() {
    mkdir -p "$CACHE_DIR" || return 1
    local err_file
    err_file=$(mktemp)
    if ! kubectl api-resources --no-headers --verbs=list 2>"$err_file" > "$CACHE_FILE.tmp"; then
        cat "$err_file" >&2
        rm -f "$CACHE_FILE.tmp" "$err_file"
        return 1
    fi
    rm -f "$err_file"
    if [[ ! -s "$CACHE_FILE.tmp" ]]; then
        rm -f "$CACHE_FILE.tmp"
        echo -e "${RED}Error: kubectl api-resources returned no rows${NC}" >&2
        return 1
    fi
    mv "$CACHE_FILE.tmp" "$CACHE_FILE"
}

ensure_cache() {
    if needs_refresh; then refresh_cache || return 1; fi
}

# ── resolve resources ──────────────────────────────────────────────────────────
# Anchors on NAMESPACED column (true|false) so SHORTNAMES presence is detected
# from column count rather than fixed offsets.
resolve_resources() {
    local pat="$1"
    local re="^$(glob_to_regex "$pat")$"
    awk -v re="$re" '
    {
        ns_idx = 0
        for (i = 2; i <= NF; i++) {
            if ($i == "true" || $i == "false") { ns_idx = i; break }
        }
        if (ns_idx == 0) next
        name = $1
        kind_lc = tolower($(ns_idx + 1))
        shortnames = (ns_idx >= 4) ? $2 : ""

        matched = 0
        if (name ~ re) matched = 1
        else if (kind_lc ~ re) matched = 1
        else if (shortnames != "") {
            n = split(shortnames, sh, ",")
            for (j = 1; j <= n; j++) if (sh[j] ~ re) { matched = 1; break }
        }
        if (matched && !(kind_lc in seen)) {
            print name
            seen[kind_lc] = 1
        }
    }' "$CACHE_FILE" | sort
}

# ── grep helper ────────────────────────────────────────────────────────────────
do_grep() {
    local re="$1"
    local cmd=(grep -E)
    [[ ${#GREP_FLAGS[@]} -gt 0 ]] && cmd+=("${GREP_FLAGS[@]}")
    cmd+=(-- "$re")
    "${cmd[@]}"
}

# Drop healthy rows when --not-ready is set. Stdin → stdout; safe on empty.
drop_ready() {
    [[ "$NOT_READY" == true ]] || { cat; return; }
    grep -Ev -- "$NOT_READY_REGEX" || true
}

# Emit compact <ns>\t<r>/<name> (or <r>/<name> if cluster-scoped or -n mode).
emit_compact() {
    local r="$1" header="$2" body="$3"
    local has_ns_col=false
    [[ "$header" =~ ^NAMESPACE[[:space:]] ]] && has_ns_col=true
    if $has_ns_col; then
        awk -v r="$r" '{print $1 "\t" r "/" $2}' <<<"$body"
    else
        awk -v r="$r" '{print r "/" $1}' <<<"$body"
    fi
}

# ── runners ────────────────────────────────────────────────────────────────────
run_single() {
    local resource="$1" pat="$2"
    local get_args=()
    if [[ "$ALL_NS" == true ]]; then get_args=("-A"); else get_args=("-n" "$NAMESPACE"); fi
    [[ ${#EXTRA_KUBECTL_ARGS[@]} -gt 0 ]] && get_args+=("${EXTRA_KUBECTL_ARGS[@]}")

    # Let kubectl's stderr pass through directly so auth/connectivity errors
    # are visible to the user.
    local out
    if ! out=$(kubectl get "$resource" "${get_args[@]}"); then
        return 2
    fi
    [[ -z "$out" ]] && return 1

    local header body
    header=${out%%$'\n'*}
    body=${out#*$'\n'}
    [[ "$header" == "$body" ]] && body=""

    if [[ -n "$pat" ]]; then
        local re
        if [[ "$REGEX_QUERY" == true ]]; then re="$pat"; else re=$(glob_to_regex "$pat"); fi
        body=$(do_grep "$re" <<<"$body" || true)
    fi
    [[ -n "$body" ]] && body=$(drop_ready <<<"$body")
    [[ -z "$body" ]] && return 1

    if [[ "$COMPACT" == true ]]; then
        emit_compact "$resource" "$header" "$body"
    else
        printf '%s\n%s\n' "$header" "$body"
    fi
}

is_benign_per_resource_err() {
    # Returns 0 if stderr looks like a per-resource error we should silently
    # skip (RBAC, missing CRD, etc.). Returns 1 otherwise (likely auth/conn).
    local f="$1"
    [[ -s "$f" ]] || return 0  # empty stderr = benign
    grep -qE 'Error from server \((Forbidden|NotFound|MethodNotAllowed)\)|the server doesn.t have a resource type|the server could not find the requested resource' "$f"
}

run_multi() {
    local pat="$1"; shift
    local re=""
    if [[ -n "$pat" ]]; then
        if [[ "$REGEX_QUERY" == true ]]; then re="$pat"; else re=$(glob_to_regex "$pat"); fi
    fi
    local get_args=()
    if [[ "$ALL_NS" == true ]]; then get_args=("-A"); else get_args=("-n" "$NAMESPACE"); fi
    [[ ${#EXTRA_KUBECTL_ARGS[@]} -gt 0 ]] && get_args+=("${EXTRA_KUBECTL_ARGS[@]}")

    # Dedup api-resource names: resolve_resources can yield the same NAME via
    # different KINDs (e.g. core pods + metrics.k8s.io pods), which would race
    # writes to the same per-resource tmpfile below.
    local -a uniq=()
    local seen_r="" r
    for r in "$@"; do
        [[ ",$seen_r," == *",$r,"* ]] && continue
        uniq+=("$r"); seen_r+=",$r"
    done
    set -- "${uniq[@]}"

    local tmpdir
    tmpdir=$(mktemp -d) || return 2
    trap 'rm -rf "$tmpdir"' RETURN

    local jobs="${KUBECTL_GREP_JOBS:-8}"

    # Fan out kubectl get calls; render sequentially below to keep output order.
    printf '%s\n' "$@" | xargs -P "$jobs" -I{} bash -c '
        r="$1"; d="$2"; shift 2
        kubectl get "$r" "$@" >"$d/$r.out" 2>"$d/$r.err"
        echo $? >"$d/$r.rc"
    ' _ {} "$tmpdir" "${get_args[@]}"

    local found_any=false r out rc header body
    for r in "$@"; do
        rc=$(<"$tmpdir/$r.rc")
        if [[ $rc -ne 0 ]]; then
            if is_benign_per_resource_err "$tmpdir/$r.err"; then
                continue
            fi
            cat "$tmpdir/$r.err" >&2
            return 2
        fi

        out=$(<"$tmpdir/$r.out")
        [[ -z "$out" ]] && continue
        header=${out%%$'\n'*}
        body=${out#*$'\n'}
        [[ "$header" == "$body" ]] && body=""
        if [[ -n "$re" ]]; then
            body=$(do_grep "$re" <<<"$body" || true)
        fi
        [[ -n "$body" ]] && body=$(drop_ready <<<"$body")
        [[ -z "$body" ]] && continue

        if [[ "$COMPACT" == true ]]; then
            emit_compact "$r" "$header" "$body"
        else
            $found_any && echo
            echo -e "${BLUE}=== ${r} ===${NC}"
            printf '%s\n%s\n' "$header" "$body"
        fi
        found_any=true
    done
    [[ "$found_any" == true ]] || return 1
}

# ── main ───────────────────────────────────────────────────────────────────────
main() {
    if ! command -v kubectl >/dev/null; then
        echo -e "${RED}Error: kubectl not in PATH${NC}" >&2; exit 2
    fi

    # Standalone --refresh-cache: rebuild and exit.
    if [[ "$REFRESH" == true && -z "$RESOURCE" ]]; then
        refresh_cache && echo "Cache refreshed: $CACHE_FILE"
        exit $?
    fi

    if [[ -z "$RESOURCE" ]]; then usage_short; exit 2; fi

    ensure_cache || exit 2

    local resources=()
    mapfile -t resources < <(resolve_resources "$RESOURCE")

    # If no match and the resource is literal, refresh cache once (CRD freshly added).
    if [[ ${#resources[@]} -eq 0 && "$RESOURCE" != *[*\?]* ]]; then
        refresh_cache 2>/dev/null && mapfile -t resources < <(resolve_resources "$RESOURCE")
    fi

    case ${#resources[@]} in
        0)
            echo -e "${RED}Error: no api-resource matches '$RESOURCE'${NC}" >&2
            exit 1
            ;;
        1)
            run_single "${resources[0]}" "$PATTERN"
            exit $?
            ;;
        *)
            run_multi "$PATTERN" "${resources[@]}"
            exit $?
            ;;
    esac
}

main "$@"

#!/usr/bin/env bash
# Cordons all nodes except those passed as arguments, or uncordons with --undo.
#
# State: when cordonx cordons nodes it records exactly which nodes it cordoned
# (per cluster context). --undo uncordons only those, leaving nodes that were
# already cordoned before cordonx ran untouched. If no saved state exists,
# --undo does nothing (so it never clobbers maintenance cordons it didn't set);
# pass --undo --all to force-uncordon every SchedulingDisabled node.

undo=0
all=0
nodes=()
PARALLEL=10

# Parse arguments
for arg in "$@"; do
  case "$arg" in
  -u | --undo)
    undo=1
    ;;
  -a | --all)
    all=1
    ;;
  *)
    nodes+=("$arg")
    ;;
  esac
done

if [ $undo -eq 0 ] && [ ${#nodes[@]} -eq 0 ]; then
  echo "Usage: kubectl cordonx <node1> [node2 ...]"
  echo "       kubectl cordonx --undo          # uncordon only nodes cordonx recorded"
  echo "       kubectl cordonx --undo --all    # uncordon every SchedulingDisabled node"
  exit 1
fi

# ── per-context state file ───────────────────────────────────────────────────
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/kubectl-cordonx"
context=$(kubectl config current-context 2>/dev/null)
[ -n "$context" ] || context="default"
# sanitize the context into a safe filename (teleport contexts contain dots/dashes)
state_key=$(printf '%s' "$context" | sed 's/[^A-Za-z0-9._-]/_/g')
state_file="$state_dir/$state_key.state"

# nodes currently in Ready,SchedulingDisabled
cordoned_nodes() {
  kubectl get nodes --no-headers | awk '$2=="Ready,SchedulingDisabled"{print $1}'
}

if [ $undo -eq 1 ]; then
  if [ $all -eq 1 ]; then
    # Explicit opt-in: uncordon every SchedulingDisabled node, recorded or not.
    echo "cordonx: --all given; uncordoning every SchedulingDisabled node" >&2
    cordoned_nodes | xargs -r -P "$PARALLEL" -I{} kubectl uncordon {}
    rm -f "$state_file"
  elif [ -s "$state_file" ]; then
    # Uncordon only the nodes cordonx recorded for this context
    grep -v '^$' "$state_file" | xargs -r -P "$PARALLEL" -I{} kubectl uncordon {}
    rm -f "$state_file"
  else
    # No saved state: do NOT touch pre-existing cordons. cordonx only ever
    # uncordons nodes it recorded, so with nothing recorded there is nothing
    # to undo. (Blindly uncordoning every SchedulingDisabled node here would
    # clobber maintenance cordons cordonx never set.)
    echo "cordonx: no saved state for context '$context'; nothing to undo" >&2
    echo "         (to force-uncordon every SchedulingDisabled node, run --undo --all)" >&2
  fi
else
  # Build exclusion regex from arguments
  exclude_regex=$(
    IFS='|'
    echo "${nodes[*]}"
  )

  # Nodes not in the exclude list (the full set cordonx will cordon).
  target_nodes=$(kubectl get nodes --no-headers | grep -vE "$exclude_regex" | awk '{print $1}')

  # Fire all cordons in parallel.
  printf '%s\n' "$target_nodes" | grep -v '^$' | xargs -r -P "$PARALLEL" -I{} kubectl cordon {}

  # Record every node this run cordoned (the full target set), merged into any
  # existing state for this context (union). Recording the whole target set —
  # rather than only nodes that weren't already cordoned — keeps state reliable
  # across re-runs: --undo always restores everything cordonx scheduled-disabled,
  # never leaving stragglers cordoned because an earlier run had already set them.
  mkdir -p "$state_dir"
  {
    [ -f "$state_file" ] && cat "$state_file"
    printf '%s\n' "$target_nodes"
  } | grep -v '^$' | sort -u >"$state_file.tmp" && mv "$state_file.tmp" "$state_file"
fi

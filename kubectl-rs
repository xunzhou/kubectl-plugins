#!/usr/bin/env bash
# kubectl rs — a Deployment's rollout history as a timeline of CHANGES.
#
# Named `kubectl-rs` (single token, no internal dash) because kubectl treats each
# dash in a plugin name as a word boundary: `kubectl-rs-timeline` would dispatch
# as `kubectl rs timeline`. So the subcommand is just `kubectl rs`.
#
# A Deployment keeps one ReplicaSet per pod-template revision; every spec change
# (image, env, resources, args, replicas) mints a new RS and scales the old to 0.
# So its ReplicaSets, sorted by creationTimestamp, ARE the rollout timeline. This
# walks that timeline and diffs CONSECUTIVE revisions, so each hunk shows what
# that rollout actually changed — not just that one happened.
#
# Companion to `kubectl diff-rs` (which compares any TWO revisions); this shows
# the WHOLE retained history at once.
set -euo pipefail

BOLD='\033[1m'; DIM='\033[2m'; RED='\033[0;31m'; GREEN='\033[0;32m'
YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'

usage() {
  cat <<'EOF'
Usage: kubectl rs <deployment> [-n NAMESPACE | -A] [options] [-- kubectl flags]

Reconstruct a Deployment's rollout history from its ReplicaSets (oldest->newest)
and diff consecutive revisions, so you see what each rollout changed and when.

  <deployment>   Deployment whose ReplicaSets to walk (matched via ownerReferences).

Options:
  -n NAMESPACE   Target a namespace (default: current-context namespace)
  -A             All namespaces (then -- name must be unique, or use ownerRef ns)
  --no-diff      Only print the timeline table, skip the consecutive diffs
  --no-neat      Skip `kubectl neat`; use the built-in jq scrub instead
  --raw          Don't normalize at all — diff full `-o yaml` (noisy)
  --plain        Use plain `diff -u` instead of `dyff` even if dyff is installed
  -P, --no-pager Don't page output (auto-pages on a TTY via $PAGER/less/bat)
  -h, --help     Show this help

Diffs render with `dyff` (semantic, path-addressed) when available, else `diff -u`.
On a terminal, output is paged through $PAGER (or `less -RF`, or `bat`); piped or
redirected output is never paged. Override the pager with $PAGER, disable with -P.

Any flag after `--` (or any unrecognized flag) is passed through to the
underlying `kubectl get rs` — e.g. --context, --kubeconfig, -l selector.

Examples:
  kubectl rs nginx
  kubectl rs nginx -n web
  kubectl rs nginx --no-diff
  kubectl rs nginx --context staging-cluster
EOF
  exit "${1:-1}"
}

ORIG_ARGS=("$@")     # preserved verbatim for the pager re-exec
DEPLOYMENT=""
NS_FLAGS=()          # -n NS  |  -A   (also reused for the human-readable scope)
SCOPE=""
DO_DIFF=true
SANITIZE="neat"      # neat | jq | raw
DIFFER="auto"        # auto (dyff if present) | plain
PASSTHRU=()          # extra flags forwarded to `kubectl get rs`
USE_PAGER=true       # auto-page on a TTY unless --no-pager (or $RS_NO_PAGER)

while [[ $# -gt 0 ]]; do
  case "$1" in
    -A)            NS_FLAGS=(-A); SCOPE="all namespaces"; shift ;;
    -n)            [[ $# -ge 2 ]] || { echo -e "${RED}Error: -n requires an argument${NC}" >&2; usage; }
                   NS_FLAGS=(-n "$2"); SCOPE="namespace '$2'"; shift 2 ;;
    -n*)           NS_FLAGS=(-n "${1#-n}"); SCOPE="namespace '${1#-n}'"; shift ;;
    --no-diff)     DO_DIFF=false; shift ;;
    --no-neat)     SANITIZE="jq"; shift ;;
    --raw)         SANITIZE="raw"; shift ;;
    --plain)       DIFFER="plain"; shift ;;
    --no-pager|-P) USE_PAGER=false; shift ;;
    -h|--help)     usage 0 ;;
    --)            shift; PASSTHRU+=("$@"); break ;;
    -*)            PASSTHRU+=("$1"); shift ;;   # unknown flag -> passthrough to kubectl
    *)             if [[ -z "$DEPLOYMENT" ]]; then DEPLOYMENT="$1"
                   else echo -e "${RED}Unexpected argument: $1${NC}" >&2; usage; fi
                   shift ;;
  esac
done

[[ -z "$DEPLOYMENT" ]] && usage

command -v jq >/dev/null 2>&1 || { echo -e "${RED}jq is required${NC}" >&2; exit 1; }
if [[ "$SANITIZE" == neat ]] && ! kubectl neat --help >/dev/null 2>&1; then
  echo -e "${YELLOW}kubectl neat not found; falling back to jq scrub (--no-neat).${NC}" >&2
  SANITIZE="jq"
fi
# Prefer dyff (semantic, path-addressed) unless --plain or it's not installed.
if [[ "$DIFFER" == auto ]]; then
  if command -v dyff >/dev/null 2>&1; then DIFFER="dyff"; else DIFFER="plain"; fi
fi

# --- Paging ------------------------------------------------------------------
# Re-exec ourselves with stdout piped to a pager, but ONLY on an interactive
# TTY — never when the output is redirected/piped (`kubectl rs ... > f`,
# `| grep`), which must stay clean. $RS_PAGED guards against infinite re-exec.
# Pager: $PAGER if set, else `less -R` (keeps ANSI color), else `bat`.
# Called LATE — after the not-found guard — so errors/usage are never paged.
maybe_page() {
  [[ "$USE_PAGER" == true && -t 1 && -z "${RS_PAGED:-}" && "${RS_NO_PAGER:-}" != 1 ]] || return 0
  local PAGER_CMD=""
  if [[ -n "${PAGER:-}" ]]; then PAGER_CMD="$PAGER"
  elif command -v less >/dev/null 2>&1; then PAGER_CMD="less -RF"
  elif command -v bat  >/dev/null 2>&1; then PAGER_CMD="bat --paging=always --color=always --style=plain"
  fi
  [[ -n "$PAGER_CMD" ]] || return 0
  export RS_PAGED=1
  # Re-run ourselves (now --no-pager) into the pager. Quitting less early sends
  # SIGPIPE upstream; that's expected, so don't let pipefail surface it as an
  # error. -F lets less skip paging when the output fits one screen.
  set +e +o pipefail
  "$0" "${ORIG_ARGS[@]}" --no-pager | $PAGER_CMD
  exit "${PIPESTATUS[1]:-0}"
}

# Default scope label when neither -n nor -A given: the current-context namespace.
if [[ ${#NS_FLAGS[@]} -eq 0 ]]; then
  cur=$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null || true)
  SCOPE="namespace '${cur:-default}'"
fi

# --- Fetch the Deployment's ReplicaSets, oldest->newest ----------------------
# Owner lineage (ownerReferences[].name == deployment) is the CORRECT filter —
# it never interleaves another deployment's ReplicaSets the way a name-grep can.
RS_JSON=$(kubectl get rs "${NS_FLAGS[@]}" "${PASSTHRU[@]}" \
            --sort-by=.metadata.creationTimestamp -o json 2>/dev/null \
          | jq --arg dep "$DEPLOYMENT" \
               '[.items[] | select(any(.metadata.ownerReferences[]?; .kind=="Deployment" and .name==$dep))]')

n=$(jq 'length' <<<"$RS_JSON" 2>/dev/null || echo 0)
if [[ "$n" -eq 0 ]]; then
  echo -e "${YELLOW}No ReplicaSets owned by Deployment '${DEPLOYMENT}' in ${SCOPE}.${NC}" >&2
  echo -e "${DIM}(Is the name right? Try: kubectl get deploy ${NS_FLAGS[*]})${NC}" >&2
  exit 1
fi

# We have real output to show — page it now (no-op off a TTY / under --no-pager).
maybe_page

# --- Timeline table (oldest -> newest) ---------------------------------------
echo -e "${BOLD}Rollout timeline — Deployment '${DEPLOYMENT}' (${SCOPE}) — ${n} ReplicaSet(s), oldest first${NC}"
{
  printf '#\tREV\tDESIRED/CUR/READY\tCREATED\tHASH\tNAMESPACE/NAME\n'
  jq -r '
    to_entries[] | .key as $i | .value as $rs
    | [ $i,
        ($rs.metadata.annotations["deployment.kubernetes.io/revision"] // "-"),
        "\($rs.spec.replicas // 0)/\($rs.status.replicas // 0)/\($rs.status.readyReplicas // 0)",
        ($rs.metadata.creationTimestamp // "-"),
        ($rs.metadata.labels["pod-template-hash"] // "-"),
        "\($rs.metadata.namespace)/\($rs.metadata.name)"
      ] | @tsv' <<<"$RS_JSON"
} | column -t -s $'\t'
echo

[[ "$DO_DIFF" == false ]] && exit 0

# --- Sanitize one RS (by array index) to its diff-able form ------------------
# Narrow to the rollout SUBSTANCE — replicas + the pod template. The bookkeeping
# (rev/name/created) is intentionally OUT: it changes on every rollout by
# definition, so it's pure noise in the diff. Those live in the timeline table
# and the per-pair "rev N -> M" label header instead. Keys sorted so the plain
# `diff -u` fallback stays line-level; dyff is order-insensitive anyway.
JQ_NARROW='{
    replicas: .spec.replicas,
    template: ( .spec.template
                | del(.metadata.labels["pod-template-hash"],
                      .metadata.annotations["kubectl.kubernetes.io/restartedAt"]) ) }'
JQ_SCRUB='del(.status, .metadata.resourceVersion, .metadata.uid,
              .metadata.generation, .metadata.managedFields,
              .metadata.creationTimestamp, .metadata.selfLink)'

emit_rev() {  # $1 = index -> normalized JSON (or yaml under --raw) on stdout
  local idx="$1"
  case "$SANITIZE" in
    neat) jq ".[$idx]" <<<"$RS_JSON" | kubectl neat | jq -S "$JQ_NARROW" ;;
    jq)   jq -S ".[$idx] | $JQ_SCRUB | $JQ_NARROW" <<<"$RS_JSON" ;;
    raw)  local name; name=$(jq -r ".[$idx].metadata.name" <<<"$RS_JSON")
          kubectl get rs "$name" "${NS_FLAGS[@]}" "${PASSTHRU[@]}" -o yaml ;;
  esac
}

# render_diff <prev-file> <cur-file> -> prints the delta; returns 0 if NO change.
render_diff() {
  if [[ "$DIFFER" == dyff ]]; then
    # -b omits dyff's ASCII banner; k8s-detection off (these are bare templates,
    # not full manifests). dyff exits 0 whether or not there are changes, so we
    # detect "no change" from its own wording.
    local out
    out=$(dyff between -b --detect-kubernetes=false --omit-header "$1" "$2" 2>/dev/null) || true
    if [[ -z "$out" || "$out" == *"no changes detected"* ]]; then return 0; fi
    printf '%s\n' "$out"; return 1
  fi
  # plain diff -u, colorized; diff returns 1 when files differ.
  if diff -u "$1" "$2" \
       | sed -e "s/^+/$(printf '\033[0;32m')+/" -e "s/^-/$(printf '\033[0;31m')-/" -e "s/$/$(printf '\033[0m')/" \
       | tail -n +3; then
    return 0
  fi
  return 1
}

# --- Consecutive-revision diffs (the timeline of CHANGES) --------------------
label() { jq -r ".[$1] | \"rev \(.metadata.annotations[\"deployment.kubernetes.io/revision\"] // \"?\") (\(.metadata.name))\"" <<<"$RS_JSON"; }

echo -e "${BOLD}Consecutive-revision diffs (each block = what that rollout changed)${NC}"
echo -e "${DIM}rev[0] is the oldest RETAINED revision, shown as the baseline. differ=${DIFFER}${NC}"
echo
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
prev_f="$tmp/prev"; cur_f="$tmp/cur"
emit_rev 0 > "$prev_f"
echo -e "${CYAN}=== baseline: $(label 0) ===${NC}"
i=1
while [[ "$i" -lt "$n" ]]; do
  emit_rev "$i" > "$cur_f"
  echo -e "${CYAN}=== $(label $((i-1)))  ->  $(label "$i") ===${NC}"
  if render_diff "$prev_f" "$cur_f"; then
    echo -e "  ${DIM}(no spec change — RS re-created/scaled only)${NC}"
  fi
  echo
  mv "$cur_f" "$prev_f"
  i=$((i+1))
done

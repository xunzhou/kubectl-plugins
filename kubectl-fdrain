#!/usr/bin/env bash
set -euo pipefail

# Drain one or more nodes, force-deleting pods the eviction API can't move
# because a PodDisruptionBudget would be violated.
#
# `kubectl drain` evicts via the eviction API, which honors PDBs: when evicting
# a pod would drop its app below minAvailable the eviction is rejected (429) and
# drain retries forever. (drain --force only deletes unmanaged pods — it does
# NOT bypass PDBs.) This wrapper runs the real drain in the background and,
# whenever a pod is still stuck because its PDB allows zero disruptions,
# force-deletes it (--force --grace-period 0, bypassing eviction and the PDB) so
# the drain can finish.
#
# Safety: fdrain only operates on nodes that are ALREADY CORDONED
# (SchedulingDisabled). Cordon the nodes you intend to take down first; fdrain
# refuses uncordoned nodes so a stray selector can't drain a live node.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

POLL=5          # seconds between straggler sweeps
GRACE=15        # seconds to let drain evict cleanly before we start forcing
TIMEOUT=600     # overall ceiling (per run, across all nodes)
YES=0
SELECTOR=""
NODES=()
DRAIN_ARGS=(--delete-emptydir-data --ignore-daemonsets)

usage() {
  cat >&2 <<EOF
Usage: kubectl fdrain [options] [node ...]

Drains the target node(s), force-deleting pods that the eviction API leaves
stuck because a PodDisruptionBudget forbids the disruption. Force-delete is
--force --grace-period 0 (bypasses eviction and the PDB).

Targets must be ALREADY CORDONED (SchedulingDisabled). Cordon first, then fdrain.

Target selection (combine as needed):
  node ...          One or more node names
  -l, --selector S  Label selector, e.g. node.info/kubeletVersion=v1.28

Options:
  --poll <sec>      Seconds between straggler sweeps (default: $POLL)
  --grace <sec>     Let normal eviction run this long before forcing (default: $GRACE)
  --timeout <sec>   Overall ceiling before giving up (default: $TIMEOUT)
  -y, --yes         Skip the destructive-op AND per-pod confirmations
  -h, --help        Show this help

Unrecognized flags pass through to 'kubectl drain' (e.g. --force,
--disable-eviction, --pod-selector). Defaults already include
--delete-emptydir-data --ignore-daemonsets.

Examples:
  kubectl fdrain ip-10-0-1-23
  kubectl fdrain -l node.info/kubeletVersion=v1.28 --force
  kubectl fdrain -y --timeout 1200 worker-7 worker-8
EOF
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -l|--selector) [[ $# -ge 2 ]] || usage; SELECTOR="$2"; shift 2 ;;
    -l*)           SELECTOR="${1#-l}"; shift ;;
    --poll)        [[ $# -ge 2 ]] || usage; POLL="$2"; shift 2 ;;
    --grace)       [[ $# -ge 2 ]] || usage; GRACE="$2"; shift 2 ;;
    --timeout)     [[ $# -ge 2 ]] || usage; TIMEOUT="$2"; shift 2 ;;
    -y|--yes)      YES=1; shift ;;
    -h|--help)     usage ;;
    --)            shift; DRAIN_ARGS+=("$@"); break ;;
    -*)            DRAIN_ARGS+=("$1"); shift ;;   # pass unknown flags to drain
    *)             NODES+=("$1"); shift ;;
  esac
done

if [[ -z "$SELECTOR" && ${#NODES[@]} -eq 0 ]]; then
  echo -e "${RED}Error: give at least one node name or -l <selector>.${NC}" >&2
  usage
fi

# ── resolve targets ───────────────────────────────────────────────────────────
# Collect candidate node names from -l and/or positional args, then keep only
# those that are currently cordoned (SchedulingDisabled).
declare -A CORDONED=()
declare -A STATUS=()
declare -A VERSION=()
while read -r name status version; do
  [[ -z "$name" ]] && continue
  [[ "$status" == *SchedulingDisabled* ]] && CORDONED["$name"]=1
  STATUS["$name"]="$status"
  VERSION["$name"]="$version"
done < <(kubectl get nodes --no-headers 2>/dev/null | awk '{print $1" "$2" "$5}')

declare -A SEEN=()
CANDIDATES=()
if [[ -n "$SELECTOR" ]]; then
  while read -r name; do
    [[ -z "$name" ]] && continue
    [[ -n "${SEEN[$name]:-}" ]] && continue
    SEEN["$name"]=1; CANDIDATES+=("$name")
  done < <(kubectl get nodes -l "$SELECTOR" --no-headers 2>/dev/null | awk '{print $1}')
fi
for n in "${NODES[@]:-}"; do
  [[ -z "$n" ]] && continue
  if [[ -z "${CORDONED[$n]:-}" && -z "$(kubectl get node "$n" --no-headers 2>/dev/null)" ]]; then
    echo -e "${RED}Error: node '$n' not found.${NC}" >&2; exit 1
  fi
  [[ -n "${SEEN[$n]:-}" ]] && continue
  SEEN["$n"]=1; CANDIDATES+=("$n")
done

TARGETS=()
SKIPPED=()
for n in "${CANDIDATES[@]}"; do
  if [[ -n "${CORDONED[$n]:-}" ]]; then TARGETS+=("$n"); else SKIPPED+=("$n"); fi
done

if [[ ${#SKIPPED[@]} -gt 0 ]]; then
  echo -e "${YELLOW}Skipping ${#SKIPPED[@]} uncordoned node(s) (cordon them first):${NC} ${SKIPPED[*]}" >&2
fi
if [[ ${#TARGETS[@]} -eq 0 ]]; then
  echo -e "${RED}No cordoned target nodes. fdrain only drains SchedulingDisabled nodes.${NC}" >&2
  exit 1
fi

# ── destructive-op confirmation ───────────────────────────────────────────────
echo -e "${RED}This is a destructive operation.${NC}"
echo -e "${BLUE}Will drain ${#TARGETS[@]} cordoned node(s) in parallel and force-delete PDB-blocked pods:${NC}"
printf "  %-38s  %-12s  %s\n" "NODE" "VERSION" "STATUS"
for n in "${TARGETS[@]}"; do
  printf "  %-38s  %-12s  %s\n" "$n" "${VERSION[$n]:-?}" "${STATUS[$n]:-?}"
done
echo -e "${BLUE}drain args:${NC} ${DRAIN_ARGS[*]}"
echo ""
if [[ $YES -eq 0 ]]; then
  prompt="$(echo -e "${RED}Proceed? [y/N]${NC} ")"
  if [[ -r /dev/tty ]]; then read -r -p "$prompt" ans < /dev/tty; else read -r -p "$prompt" ans; fi
  case "$ans" in [yY]) ;; *) echo -e "${YELLOW}Aborted.${NC}"; exit 0 ;; esac
fi

# Is this pod stuck because its PDB has no disruptions to give? Find a PDB in
# the pod's namespace whose selector covers the pod and whose ALLOWED
# DISRUPTIONS is 0. jq does the selector match (matchLabels + matchExpressions)
# against the pod's labels — exit 0 = blocked, exit 1 = not blocked.
pdb_blocked() {
  local ns="$1" pod="$2"
  local pod_json pdb_json
  pod_json=$(kubectl get pod "$pod" -n "$ns" -o json 2>/dev/null) || return 1
  pdb_json=$(kubectl get pdb -n "$ns" -o json 2>/dev/null) || return 1

  jq -e -n --argjson pod "$pod_json" --argjson pdbs "$pdb_json" '
    ($pod.metadata.labels // {}) as $labels
    | [ $pdbs.items[]
        | select((.status.disruptionsAllowed // 1) <= 0)
        | (.spec.selector // {}) as $sel
        | ( [ ($sel.matchLabels // {}) | to_entries[]
              | $labels[.key] == .value ] | all )
          and
          ( [ ($sel.matchExpressions // [])[]
              | .key as $k | .operator as $op | (.values // []) as $vals
              | if   $op == "In"           then ($labels[$k] as $v | $v != null and ($vals | index($v)) != null)
                elif $op == "NotIn"        then ($labels[$k] as $v | $v == null or  ($vals | index($v)) == null)
                elif $op == "Exists"       then ($labels | has($k))
                elif $op == "DoesNotExist" then ($labels | has($k) | not)
                else true end ] | all )
          and
          # an empty selector matches nothing for our purposes (avoid false hits)
          (($sel.matchLabels // {} | length) + ($sel.matchExpressions // [] | length) > 0)
      ] | any' >/dev/null
}

# Pods drain still has to move off a node: everything scheduled there that
# isn't DaemonSet-managed or already terminal. These are the candidates drain
# evicts — and the ones a PDB can block.
drainable_pods() {
  local node="$1"
  kubectl get pods -A --field-selector "spec.nodeName=$node" \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.metadata.name}{" "}{.metadata.ownerReferences[0].kind}{" "}{.status.phase}{"\n"}{end}' \
    2>/dev/null \
    | awk '$3!="DaemonSet" && $4!="Succeeded" && $4!="Failed" {print $1" "$2}'
}

# ── kick off the real drains in parallel ──────────────────────────────────────
LOG_DIR=$(mktemp -d)
cleanup() { rm -rf "$LOG_DIR"; }
trap cleanup EXIT

declare -A DRAIN_PID=()
for n in "${TARGETS[@]}"; do
  kubectl drain "$n" "${DRAIN_ARGS[@]}" >"$LOG_DIR/$n.log" 2>&1 &
  DRAIN_PID["$n"]=$!
done
echo -e "${BLUE}Started ${#TARGETS[@]} drain(s).${NC} Letting eviction run for ${GRACE}s before forcing PDB-blocked pods..."

node_done() { ! kill -0 "${DRAIN_PID[$1]}" 2>/dev/null; }
all_done() {
  local n
  for n in "${TARGETS[@]}"; do node_done "$n" || return 1; done
  return 0
}

START=$(date +%s)
FORCED_TOTAL=0

while true; do
  all_done && break

  ELAPSED=$(( $(date +%s) - START ))
  if [[ $ELAPSED -ge $TIMEOUT ]]; then
    echo -e "\n${RED}Timeout (${TIMEOUT}s) — aborting remaining drains.${NC}" >&2
    for n in "${TARGETS[@]}"; do node_done "$n" || kill "${DRAIN_PID[$n]}" 2>/dev/null || true; done
    break
  fi

  # Don't fight clean evictions during the grace window.
  if [[ $ELAPSED -lt $GRACE ]]; then sleep "$POLL"; continue; fi

  # Sweep every still-draining node for stragglers pinned by a 0-allowance PDB.
  for n in "${TARGETS[@]}"; do
    node_done "$n" && continue
    while read -r ns pod; do
      [[ -z "$ns" || -z "$pod" ]] && continue
      if pdb_blocked "$ns" "$pod"; then
        if [[ $YES -eq 0 ]]; then
          msg="$(echo -e "${RED}PDB blocks${NC} $ns/$pod (on $n) — force-delete? [y/N] ")"
          if [[ -r /dev/tty ]]; then read -r -p "$msg" ans < /dev/tty
          else read -r -p "$msg" ans; fi
          case "$ans" in [yY]) ;; *) echo -e "  ${YELLOW}$ns/$pod skipped${NC}"; continue ;; esac
        fi
        printf "${BLUE}Force-deleting${NC} %s/%s ... " "$ns" "$pod"
        if kubectl delete pod "$pod" -n "$ns" --force --grace-period 0 --wait=false 2>/dev/null; then
          echo -e "${GREEN}done${NC}"
          FORCED_TOTAL=$((FORCED_TOTAL + 1))
        else
          echo -e "${RED}FAILED${NC}"
        fi
      fi
    done < <(drainable_pods "$n")
  done

  sleep "$POLL"
done

# ── reap drains and report per node ───────────────────────────────────────────
echo ""
FAILED=0
for n in "${TARGETS[@]}"; do
  wait "${DRAIN_PID[$n]}" 2>/dev/null
  rc=$?
  if [[ $rc -eq 0 ]]; then
    echo -e "${GREEN}✓${NC} $n drained"
  else
    echo -e "${RED}✗${NC} $n drain rc=$rc"
    [[ -s "$LOG_DIR/$n.log" ]] && tail -n 3 "$LOG_DIR/$n.log" | sed 's/^/    /'
    FAILED=$((FAILED + 1))
  fi
done

echo ""
echo -e "Summary: ${GREEN}$(( ${#TARGETS[@]} - FAILED )) drained${NC}  ${RED}${FAILED} failed${NC}  •  force-deleted ${FORCED_TOTAL} PDB-blocked pod(s)."
[[ $FAILED -eq 0 ]] || exit 1

#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
  cat <<'EOF'
Usage: kubectl prune <pattern> [-n NAMESPACE | -A]
       kubectl prune --all [-n NAMESPACE | -A]

Force-delete pods after confirmation. Always uses --force --grace-period 0.

  <pattern>   Delete pods whose `kubectl get po` line matches a (regex) pattern.
              Matches against the entire line (name, status, restarts, age, etc.).
  --all       Delete all UNHEALTHY pods (READY not X/X and not Completed/Succeeded).

Options:
  -n NAMESPACE   Target a specific namespace
  -A             All namespaces
  -h, --help     Show this help

Default: current context namespace.

Examples:
  kubectl prune istio-proxy
  kubectl prune '^istio-' -n istio-system
  kubectl prune crashloop -A
  kubectl prune --all -A
EOF
  exit 1
}

NAMESPACE=""
ALL_NS=false
PATTERN=""
ALL_UNHEALTHY=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -A)        ALL_NS=true; NAMESPACE=""; shift ;;
    --all)     ALL_UNHEALTHY=true; shift ;;
    -n)        [[ $# -ge 2 ]] || { echo -e "${RED}Error: -n requires an argument${NC}" >&2; usage; }
               NAMESPACE="$2"; ALL_NS=false; shift 2 ;;
    -n*)       NAMESPACE="${1#-n}"; ALL_NS=false; shift ;;
    -h|--help) usage ;;
    -*)        echo -e "${RED}Unknown flag: $1${NC}" >&2; usage ;;
    *)
      if [[ -z "$PATTERN" ]]; then PATTERN="$1"
      else echo -e "${RED}Unexpected argument: $1${NC}" >&2; usage
      fi
      shift ;;
  esac
done

if [[ "$ALL_UNHEALTHY" == true ]]; then
  [[ -n "$PATTERN" ]] && { echo -e "${RED}Error: --all cannot be combined with a name pattern${NC}" >&2; usage; }
else
  # Empty pattern matches everything — refuse it to avoid nuking the namespace.
  [[ -z "$PATTERN" ]] && usage
fi

# ── fetch pod list ──────────────────────────────────────────────────────────
if [[ "$ALL_NS" == true ]]; then
  NAME_COL=2
  SCOPE="all namespaces"
  POD_LIST=$(kubectl get po -A --no-headers 2>/dev/null || true)
elif [[ -n "$NAMESPACE" ]]; then
  NAME_COL=1
  SCOPE="namespace '$NAMESPACE'"
  POD_LIST=$(kubectl get po -n "$NAMESPACE" --no-headers 2>/dev/null || true)
else
  NAME_COL=1
  NAMESPACE=$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null || true)
  [[ -z "$NAMESPACE" ]] && NAMESPACE="default"
  SCOPE="namespace '$NAMESPACE'"
  POD_LIST=$(kubectl get po -n "$NAMESPACE" --no-headers 2>/dev/null || true)
fi

# ── filter ───────────────────────────────────────────────────────────────────
# Columns: [NS] NAME READY STATUS RESTARTS AGE. READY = NAME_COL+1, STATUS = NAME_COL+2.
if [[ "$ALL_UNHEALTHY" == true ]]; then
  # Unhealthy = READY not X/X, OR STATUS not in {Running,Completed,Succeeded}.
  MATCHED=$(printf '%s\n' "$POD_LIST" | awk -v c="$NAME_COL" '
    NF {
      ready = $(c+1); status = $(c+2)
      n = split(ready, r, "/")
      ready_full = (n == 2 && r[1] == r[2] && r[1] != "0")
      status_ok = (status == "Running" || status == "Completed" || status == "Succeeded")
      if (!(ready_full && status_ok)) print
    }' || true)
  DESC="unhealthy pods"
else
  MATCHED=$(printf '%s\n' "$POD_LIST" | awk -v p="$PATTERN" 'NF && $0 ~ p' || true)
  DESC="pods matching '$PATTERN'"
fi

if [[ -z "$MATCHED" ]]; then
  echo -e "${YELLOW}No ${DESC} in $SCOPE.${NC}" >&2
  exit 0
fi

# ── confirm ─────────────────────────────────────────────────────────────────
POD_COUNT=$(printf '%s\n' "$MATCHED" | grep -c .)
echo -e "${BLUE}${DESC^} in $SCOPE:${NC}"
printf '%s\n' "$MATCHED" | while IFS= read -r line; do echo "  $line"; done
echo ""

PROMPT="$(echo -e "${RED}Force-delete ${POD_COUNT} pod(s)? [y/N]${NC} (--force --grace-period 0): ")"
if [[ -r /dev/tty ]]; then
  read -r -p "$PROMPT" confirm < /dev/tty
else
  read -r -p "$PROMPT" confirm
fi
case "$confirm" in
  [yY]) ;;
  *)    echo -e "${YELLOW}Aborted.${NC}"; exit 0 ;;
esac

# ── delete ──────────────────────────────────────────────────────────────────
echo ""
DELETED=0
FAILED=0

while IFS= read -r line; do
  [[ -z "$line" ]] && continue

  if [[ "$ALL_NS" == true ]]; then
    POD_NS=$(awk '{print $1}' <<< "$line")
    POD_NAME=$(awk '{print $2}' <<< "$line")
  else
    POD_NS="$NAMESPACE"
    POD_NAME=$(awk '{print $1}' <<< "$line")
  fi

  printf "${BLUE}Deleting${NC} %s/%s ... " "$POD_NS" "$POD_NAME"
  if kubectl delete pod -n "$POD_NS" "$POD_NAME" --force --grace-period 0 --wait=false 2>/dev/null; then
    echo -e "${GREEN}done${NC}"
    DELETED=$((DELETED + 1))
  else
    echo -e "${RED}FAILED${NC}"
    FAILED=$((FAILED + 1))
  fi
done <<< "$MATCHED"

echo ""
echo -e "Summary: ${GREEN}${DELETED} deleted${NC}  ${RED}${FAILED} failed${NC}"
